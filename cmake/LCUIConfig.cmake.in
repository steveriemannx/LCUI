@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@Freetype_FOUND@)
    find_dependency(Freetype)
endif()
if(@PNG_FOUND@)
    find_dependency(PNG)
endif()
if(@JPEG_FOUND@)
    find_dependency(JPEG)
endif()
if(@LibXml2_FOUND@)
    find_dependency(LibXml2)
endif()
if(@OpenMP_C_FOUND@)
    find_dependency(OpenMP COMPONENTS C)
endif()
if(@LCUI_HAS_FONTCONFIG@ OR @LCUI_HAS_LIBYAML@)
    find_dependency(PkgConfig)
endif()
if(@LCUI_HAS_FONTCONFIG@)
    pkg_check_modules(FONTCONFIG REQUIRED IMPORTED_TARGET fontconfig)
endif()
if(@LCUI_HAS_LIBYAML@)
    if(@LCUI_YAML_USE_PKGCONFIG@)
        find_dependency(PkgConfig)
        pkg_check_modules(LIBYAML REQUIRED IMPORTED_TARGET yaml-0.1)
    else()
        find_path(LIBYAML_INCLUDE_DIR yaml.h REQUIRED)
        find_library(LIBYAML_LIBRARY NAMES yaml yaml-0 REQUIRED)
        add_library(PkgConfig::LIBYAML UNKNOWN IMPORTED)
        set_target_properties(PkgConfig::LIBYAML PROPERTIES
            IMPORTED_LOCATION "${LIBYAML_LIBRARY}"
            INTERFACE_INCLUDE_DIRECTORIES "${LIBYAML_INCLUDE_DIR}"
        )
    endif()
endif()
if(@LIBX11_FOUND@)
    find_dependency(PkgConfig)
    pkg_check_modules(LIBX11 REQUIRED IMPORTED_TARGET x11)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/LCUITargets.cmake")
